def word_to_num(worded_number_string):
    if worded_number_string is None:
        return None

    # Remove 'Dollars' and 'and 00/100' as they are consistent in the examples.
    # For a more robust solution, a dedicated natural language processing (NLP) library
    # or a more comprehensive word-to-number converter would be needed.
    processed_string = worded_number_string.replace(' Dollars', '').replace('and 00/100', '').strip()

    # Simple mapping for the specific cases observed in the lease documents.
    # Extend this mapping or implement a more general parser as needed.
    if processed_string == "Two Thousand Eight Hundred":
        return 2800.00
    elif processed_string == "Four Thousand Two Hundred":
        return 4200.00
    # If the string doesn't match a known pattern, it's considered ambiguous/unparseable.
    return None
