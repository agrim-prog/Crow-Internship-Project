# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored - never commit your real key.
#
# Note: this file is only read by the Streamlit app (code/app.py).
# The command-line scripts need the key exported in your shell:
#   export ANTHROPIC_API_KEY="your-key-here"

ANTHROPIC_API_KEY=your-key-here
